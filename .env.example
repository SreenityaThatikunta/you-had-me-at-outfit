# Keep this server-side. Never add it to VITE_ variables or browser code.
OPENAI_API_KEY=your_api_key_here
# Optional: set any vision-capable Responses API model available to your account.
OPENAI_GARMENT_MODEL=gpt-5.6-luna
# Optional: image-editing model used by the explicit "Polish with AI" action.
OPENAI_IMAGE_MODEL=gpt-image-2
